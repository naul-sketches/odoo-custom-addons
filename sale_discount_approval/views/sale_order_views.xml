<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_inherit_discount_approval"
            model="ir.ui.view">
        <field name="name">sale.order.form.discount.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Header action buttons -->
            <xpath expr="//header" position="inside">
                <button name="action_request_approval"
                        string="Request approval"
                        type="object"
                        class="btn-warning"
                        invisible="approval_state in ('approved', 'pending')
                                   or max_discount_applied &lt;= 15.0
                                   or state != 'draft'"/>
                <button name="action_approve_discount"
                        string="Approve discount"
                        type="object"
                        class="btn-success"
                        groups="sales_team.group_sale_manager"
                        invisible="approval_state != 'pending'"/>
                <button name="action_reject_discount"
                        string="Reject discount"
                        type="object"
                        class="btn-secondary"
                        groups="sales_team.group_sale_manager"
                        invisible="approval_state != 'pending'"/>
            </xpath>

            <!-- Status alert banners -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0"
                     role="alert"
                     invisible="approval_state != 'pending'">
                    <strong>Pending approval:</strong> This order contains
                    discounts exceeding 15% and requires manager
                    authorization before confirmation.
                </div>
                <div class="alert alert-danger mb-0"
                     role="alert"
                     invisible="approval_state != 'rejected'">
                    <strong>Order rejected:</strong> Manager rejected this
                    discount request. Reason:
                    <field name="rejection_reason" readonly="1"/>
                </div>
            </xpath>

            <!-- Audit trail notebook tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Discount approval audit"
                      name="discount_approval_audit">
                    <group>
                        <group>
                            <field name="approval_state" readonly="1"/>
                            <field name="max_discount_applied" readonly="1"/>
                        </group>
                        <group>
                            <field name="approval_user_id" readonly="1"/>
                            <field name="approval_date" readonly="1"/>
                        </group>
                    </group>
                    <field name="rejection_reason"
                           placeholder="Rejection notes..."
                           readonly="approval_state not in (
                                     'pending', 'rejected')"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
